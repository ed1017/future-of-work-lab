# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# ed-ai.app uses gpt-5.6-luna.
OPENAI_MODEL=
# USD per million tokens for OPENAI_MODEL, from OpenAI's pricing page. Scoring records
# each run's cost with these and refuses to start without them.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=

# The one account allowed to run scoring and edit the register.
ADMIN_EMAIL=

# Optional, for the live access test only. The anon (publishable) key is not a secret.
SUPABASE_ANON_KEY=

# Admin sign-in for the governance register (Supabase Auth emails a one-time code to ADMIN_EMAIL).
# A random string of 32+ characters that signs the admin session cookie. Server only; keep it secret.
ADMIN_SESSION_SECRET=
# SUPABASE_ANON_KEY (above) is also used to send the sign-in code. Do not use the service role key for it.
